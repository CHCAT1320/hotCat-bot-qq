{
  "name": "hotcat-bot-qq",
  "version": "0.1.8",
  "description": "基于 node-napcat-ts 的 TypeScript QQ 机器人框架",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./message": {
      "types": "./dist/message.d.ts",
      "default": "./dist/message.js"
    },
    "./botApi": {
      "types": "./dist/botApi.d.ts",
      "default": "./dist/botApi.js"
    },
    "./botClient": {
      "types": "./dist/botClient.d.ts",
      "default": "./dist/botClient.js"
    },
    "./botConsole": {
      "types": "./dist/botConsole.d.ts",
      "default": "./dist/botConsole.js"
    },
    "./botEvent": {
      "types": "./dist/botEvent.d.ts",
      "default": "./dist/botEvent.js"
    },
    "./botScheduler": {
      "types": "./dist/botScheduler.d.ts",
      "default": "./dist/botScheduler.js"
    },
    "./botPlugin": {
      "types": "./dist/botPlugin.d.ts",
      "default": "./dist/botPlugin.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "plugins/hotCatPlugin",
    "LICENSE",
    "README.md",
    "logo.png"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:plugin": "tsc --outDir plugins/hotCatPlugin --rootDir plugins/hotCatPlugin --module ESNext --target ES2020 --moduleResolution bundler --declaration --skipLibCheck plugins/hotCatPlugin/index.ts",
    "prepublishOnly": "bun run build && bun run build:plugin",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "qq",
    "bot",
    "napcat",
    "onebot",
    "typescript",
    "chatbot"
  ],
  "author": "CHCAT1320",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CHCAT1320/hotCat-bot-qq"
  },
  "dependencies": {
    "node-napcat-ts": "^0.4.25",
    "node-schedule": "^2.1.1",
    "@types/node": "^26.1.2"
  },
  "devDependencies": {
    "@types/node-schedule": "^2.1.8",
    "dependency-cruiser": "^17.4.3",
    "madge": "^8.0.0",
    "patch-package": "^8.0.1",
    "vitepress": "^1.6.4"
  }
}
